# ResMgrCheck HTTPS only; generated from a reviewed immutable driver.
server {
    listen 80;
    listen [::]:80;
    server_name qnx-resmgrcheck.gestionatech.de;
    access_log /var/log/nginx/resmgrcheck-access.log resmgrcheck_safe;
    error_log /var/log/nginx/resmgrcheck-error.log crit;
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/resmgrcheck-acme;
        default_type text/plain;
        limit_except GET { deny all; }
        try_files $uri =404;
    }
    location / { return 308 https://qnx-resmgrcheck.gestionatech.de$request_uri; }
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name qnx-resmgrcheck.gestionatech.de;
    ssl_certificate /etc/letsencrypt/live/qnx-resmgrcheck.gestionatech.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qnx-resmgrcheck.gestionatech.de/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:resmgrcheck_tls:1m;
    ssl_session_tickets off;
    server_tokens off;
    client_max_body_size 256k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    send_timeout 30s;
    access_log /var/log/nginx/resmgrcheck-access.log resmgrcheck_safe;
    error_log /var/log/nginx/resmgrcheck-error.log crit;
    limit_req zone=resmgrcheck_auth_post burst=8 nodelay;
    limit_req_status 429;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "$resmgrcheck_frame" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "$resmgrcheck_csp" always;
    add_header Cache-Control "no-store" always;
    location /static/ {
        alias /var/lib/resmgrcheck/static/3f4bafbd7d423fb5e55fc1e0f6a8ef326a273f58/;
        autoindex off;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "$resmgrcheck_frame" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "$resmgrcheck_csp" always;
        add_header Cache-Control "public, max-age=300" always;
    }
    location ~ (^|/)\. { return 404; }
    # Deployment contract: customer-host qualification is still outstanding.
    location ^~ /runner/ { return 404; }
    location / {
        proxy_pass http://unix:/run/resmgrcheck-web/application.sock;
        proxy_set_header Host qnx-resmgrcheck.gestionatech.de;
        proxy_set_header X-Real-IP $realip_remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For '';
        proxy_set_header Forwarded '';
        proxy_cache off;
        proxy_buffering off;
        gzip off;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Cache-Control;
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
        proxy_send_timeout 35s;
    }
}
