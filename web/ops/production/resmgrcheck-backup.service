[Unit]
Description=ResMgrCheck protected encrypted snapshot (no QNX contact)
Requires=resmgrcheck-db.service
After=resmgrcheck-db.service

[Service]
Type=oneshot
User=root
SupplementaryGroups=resmgr-evidence resmgr-dbclients
UMask=0077
ExecStart=/opt/resmgrcheck/current/.venv/bin/python /opt/resmgrcheck/current/web/ops/production/nightly_backup.py
TimeoutStartSec=300
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
InaccessiblePaths=/etc/resmgrcheck/executor /etc/resmgrcheck/ai /var/lib/resmgrcheck/private/executor
ReadWritePaths=/var/backups/resmgrcheck /var/lib/resmgrcheck/private/backup
MemoryMax=512M
TasksMax=24

[Install]
WantedBy=multi-user.target
